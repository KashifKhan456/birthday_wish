<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8ec5fc"/>
      <stop offset="100%" stop-color="#e0c3fc"/>
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <circle cx="300" cy="220" r="80" fill="rgba(255,255,255,0.3)"/>
  <circle cx="500" cy="220" r="100" fill="rgba(255,255,255,0.2)"/>
  <text x="400" y="270" font-size="80" text-anchor="middle">✨</text>
  <text x="400" y="440" font-family="'Plus Jakarta Sans', sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle">One Of My Favorite Memories ✨</text>
  <text x="400" y="480" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" fill="rgba(255,255,255,0.9)" text-anchor="middle">Laughter that lasts forever</text>
