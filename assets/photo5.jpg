<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#a1c4fd"/>
      <stop offset="100%" stop-color="#c2e9fb"/>
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <text x="400" y="270" font-size="90" text-anchor="middle">🌸</text>
  <text x="400" y="440" font-family="'Plus Jakarta Sans', sans-serif" font-size="28" font-weight="bold" fill="#1e3a8a" text-anchor="middle">Sweet Moments Together 🌸</text>
  <text x="400" y="480" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" fill="#1e40af" text-anchor="middle">Every second spent with you is a gift</text>
</svg>
