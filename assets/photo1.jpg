<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff758c"/>
      <stop offset="100%" stop-color="#ff7eb3"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="5" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <circle cx="400" cy="260" r="120" fill="rgba(255,255,255,0.2)" filter="url(#glow)"/>
  <path d="M400,290 C400,290 280,200 280,140 C280,95 315,60 360,60 C385,60 400,75 400,75 C400,75 415,60 440,60 C485,60 520,95 520,140 C520,200 400,290 400,290 Z" fill="#ffffff" opacity="0.9" filter="url(#glow)"/>
  <text x="400" y="440" font-family="'Plus Jakarta Sans', sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle">A Beautiful Moment ❤️</text>
  <text x="400" y="480" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" fill="rgba(255,255,255,0.85)" text-anchor="middle">Unforgettable memory filled with warmth</text>
</svg>
