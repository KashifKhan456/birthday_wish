  <rect width="100%" height="100%" fill="url(#bg)"/>
  <text x="400" y="270" font-size="90" text-anchor="middle">🎁</text>
  <text x="400" y="440" font-family="'Plus Jakarta Sans', sans-serif" font-size="28" font-weight="bold" fill="#7c2d12" text-anchor="middle">Forever Cherished 💖</text>
  <text x="400" y="480" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" fill="#9a3412" text-anchor="middle">Here's to a lifetime of happiness</text>
</svg>
